# Vercel AI Gateway — powers the /editor "Assistant" chat and shape generation.
# On Vercel this is provided automatically via OIDC. For local dev, create an
# AI Gateway API key (Vercel dashboard → AI Gateway → API Keys) and set it here.
AI_GATEWAY_API_KEY=

# Optional: override the chat model (default: openai/gpt-5.6-luna).
# PRINTA_CHAT_MODEL=openai/gpt-5.5

# Early-access gate for the /chat page. Anyone visiting /chat must enter this
# password once (stored in an httpOnly cookie). If unset, a built-in default is
# used so the page still works, but set your own in Vercel for real gating.
CHAT_SIGNUP_PASSWORD=

# Google Maps Platform. Two uses, both server-side:
#   · Map Tiles API — baking a photogrammetric place surface.
#   · Geocoding API — address search in the editor's place panel.
# Without it the mapped-buildings capture still works and search falls back to
# OpenStreetMap's geocoder, which knows landmarks but not house numbers.
GOOGLE_MAPS_API_KEY=

# Convex. Two uses:
#   · the store for models too large for a URL — a captured place, and later a
#     saved project — read and written by the server (CONVEX_URL).
#   · where rendered template screenshots live (npm run shots).
# `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL into .env.local for you; set
# CONVEX_URL in production to the production deployment.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=

# WorkOS AuthKit — sign-in, so projects follow someone between browsers. The
# CLI provisions all three: `workos env provision`, then
# `workos config redirect add https://your-domain/callback`.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Any 32+ character secret; AuthKit encrypts its session cookie with it.
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Stripe — Pro subscriptions. `npm run setup:stripe` creates the product and
# price and prints these back. Without them the site runs and the Pro button
# says billing is not live yet.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
